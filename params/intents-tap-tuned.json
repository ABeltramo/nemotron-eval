{
  "intents_models": {
    "judge": {
      "name": "gemma-4-26b"
    },
    "attacker": {
      "name": "gemma-4-26b"
    },
    "evaluator": {
      "name": "gemma-4-26b"
    },
    "sdg": {
      "name": "gemma-4-26b"
    }
  },
  "garak_config": {
    "system": {
      "parallel_requests": true,
      "parallel_attempts": 16
    },
    "run": {
      "generations": 1
    },
    "plugins": {
      "probe_spec": "spo.SPOIntent,spo.SPOIntentUserAugmented,spo.SPOIntentSystemAugmented,spo.SPOIntentBothAugmented,multilingual.TranslationIntent,tap.TAPIntent",
      "probes": {
        "spo": {
          "SPOIntent": {
            "max_dan_samples": 20
          },
          "SPOIntentUserAugmented": {
            "max_dan_samples": 20
          },
          "SPOIntentSystemAugmented": {
            "max_dan_samples": 20
          },
          "SPOIntentBothAugmented": {
            "max_dan_samples": 20
          }
        },
        "multilingual": {
          "TranslationIntent": {
            "target_lang": "zh",
            "parallelisable_attempts": true
          }
        },
        "tap": {
          "TAPIntent": {
            "width": 4,
            "depth": 4,
            "branching_factor": 2
          }
        }
      }
    }
  }
}